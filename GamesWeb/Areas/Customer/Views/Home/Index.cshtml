@model IEnumerable<Game>
@{
    ViewData["Title"] = "Index";
}
<form method="get" asp-action="Index" class="mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <select name="categoryId" class="form-select" asp-items="ViewBag.CategoryList">
                <option value="">-- Toutes les catégories --</option>
            </select>
        </div>
        <div class="col-md-4">
            <select name="platformId" class="form-select" asp-items="ViewBag.PlatformList">
                <option value="">-- Toutes les plateformes --</option>
            </select>
        </div>
        <div class="col-md-3 position-relative">
            <input type="text" id="searchNameInput" name="searchName"
                   value="@Context.Request.Query["searchName"]"
                   class="form-control" placeholder="Rechercher par nom..." autocomplete="off" />
            <div id="suggestionsBox" class="list-group position-absolute w-100" style="z-index:1000;"></div>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary form-control">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>
</form>
<div class="row pb-3">
    @foreach (var game in Model)
    {
        <div class="col-lg-3 col-sm-6">
            <div class="row p-2">
                <div class="col-12 p-1">
                    <div class="card border-0 p-3 shadow border-top border-5 rounded">
                        <img src="@game.ImageUrl" class="card-img-top rounded" />
                        <div class="card-body pb-0">
                            <div class="pl-1">
                                <p class="card-title h5 text-dark opacity-75 text-uppercase text-center">@game.Title</p>
                                <p class="card-title text-warning text-center"> By : <b>@game.Producer</b></p>
                            </div>
                            <div class="pl-1">
                                <p class="text-dark text-opacity-75 text-center mb-0">
                                    List Prix : 
                                    <span class="text-decoration-line-through">
                                        @game.ListPrice.ToString("c")
                                    </span>
                                </p>
                            </div>
                            <div class="pl-1">
                                <p class="text-dark text-opacity-75 text-center">
                                    Le Plus Bas Prix : 
                                    <span>
                                        @game.PriceWalmart.ToString("c")
                                    </span>
                                </p>
                            </div>
                        </div>
                        <div>
                            <a asp-action="Details" asp-route-id="@game.Id" class="btn btn-primary bg-gradient border-0 form-control">Details</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
@section Scripts {
    <script src="~/js/search.js"></script>
}