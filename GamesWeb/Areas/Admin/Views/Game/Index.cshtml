@model List<Game>

@{
    ViewData["Title"] = "Index";
}

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Liste des Jeux</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="Game" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle">Creer Nouveau Jeux</i>
                </a>
            </div>
        </div>
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Id)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Title)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Producer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().ListPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().PriceWalmart)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().PriceAmazon)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().PriceABGames)
                    </th>
                    <th>
                        Categorie
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Title)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Producer)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ListPrice)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PriceWalmart)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PriceAmazon)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PriceABGames)
                        </td>
                        <td>
                            
                        </td>
                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Game" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary mx-2">
                                    <i class="bi bi-pencil-square">Modifier</i>
                                </a>
                                <a asp-controller="Game" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger mx-2">
                                    <i class="bi bi-trash-fill">Supprimer</i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
