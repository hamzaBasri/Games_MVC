@model List<Game>

@{
    ViewData["Title"] = "Index";
}

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Liste des Jeux</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="Game" asp-action="Upsert" class="btn btn-primary">
                    <i class="bi bi-plus-circle">Creer Nouveau Jeux</i>
                </a>
            </div>
        </div>
        <table id="tblData"  class="table table-bordered table-striped" width="100%">
            <thead>
                <tr>                  
                    <th>
                        @Html.DisplayNameFor(model => model.First().Title)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Producer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().ListPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().PriceWalmart)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().PriceAmazon)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().PriceEBGames)
                    </th>
                    <th>
                        Categorie
                    </th>
                    <th>
                        buttons
                    </th>
                </tr>
            </thead>
            
        </table>
    </div>
</div>

@section Scripts{
<script src="~/js/game.js"></script>
}
