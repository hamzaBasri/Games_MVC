@model Game

@{
    ViewData["Title"] = "Delete";
}
<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Supprimer Categorie</h2>

            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post">
            <input asp-for="Id" hidden />
            <div class="border p-3 mt-4">
                <div class="form-floating py-2 col-12">
                    <input asp-for="Title" disabled class="form-control border-0 shadow" />
                    <label asp-for="Title" class="ms-2"></label>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Description" disabled class="form-control border-0 shadow" />
                    <label asp-for="Description" class="ms-2"></label>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Producer" disabled class="form-control border-0 shadow" />
                    <label asp-for="Producer" class="ms-2"></label>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="ListPrice" disabled class="form-control border-0 shadow" />
                    <label asp-for="ListPrice" class="ms-2"></label>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="PriceWalmart" disabled class="form-control border-0 shadow" />
                    <label asp-for="PriceWalmart" class="ms-2"></label>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="PriceAmazon" disabled class="form-control border-0 shadow" />
                    <label asp-for="PriceAmazon" class="ms-2"></label>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="PriceABGames" disabled class="form-control border-0 shadow" />
                    <label asp-for="PriceABGames" class="ms-2"></label>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-danger form-control">Suprimer</button>
                </div>
                <div class="col-6  col-md-3">
                    <a asp-controller="Game" asp-action="Index" class="btn btn-secondary border form-control">
                        Retour
                    </a>
                </div>
            </div>

        </form>

    </div>
</div>


