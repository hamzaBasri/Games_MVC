@model GameVM
@{
    ViewData["Title"] = "Create";
}
<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Creer Categorie</h2>

            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row" enctype="multipart/form-data">
            <div class="border p-3">                
                <div asp-validation-summary="All"></div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Game.Title" class="form-control border-0 shadow" />
                    <label asp-for="Game.Title" class="ms-2"></label>
                    <span asp-validation-for="Game.Title" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Game.Description" class="form-control border-0 shadow" />
                    <label asp-for="Game.Description" class="ms-2"></label>
                    <span asp-validation-for="Game.Description" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Game.Producer" class="form-control border-0 shadow" />
                    <label asp-for="Game.Producer" class="ms-2"></label>
                    <span asp-validation-for="Game.Producer" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Game.ListPrice" class="form-control border-0 shadow" />
                    <label asp-for="Game.ListPrice" class="ms-2"></label>
                    <span asp-validation-for="Game.ListPrice" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Game.PriceWalmart" class="form-control border-0 shadow" />
                    <label asp-for="Game.PriceWalmart" class="ms-2"></label>
                    <span asp-validation-for="Game.PriceWalmart" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Game.PriceAmazon" class="form-control border-0 shadow" />
                    <label asp-for="Game.PriceAmazon" class="ms-2"></label>
                    <span asp-validation-for="Game.PriceAmazon" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Game.PriceABGames" class="form-control border-0 shadow" />
                    <label asp-for="Game.PriceABGames" class="ms-2"></label>
                    <span asp-validation-for="Game.PriceABGames" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <select asp-for="@Model.Game.CategoryId" asp-items="@Model.CategoryList" class="form-select border-0 shadow">
                        <option disabled selected>Choisir une categorie</option>
                    </select>
                    <label asp-for="@Model.Game.CategoryId" class="ms-2"></label>
                    <span asp-validation-for="@Model.Game.CategoryId" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input type="file" class="form-control border-0 shadow" />
                    <label asp-for="Game.ImageUrl" class="ms-2"></label>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-primary form-control">Creer</button>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Game" asp-action="Index" class="btn btn-outline-primary border form-control">
                        Retour
                    </a>
                </div>
            </div>

        </form>
    </div>
</div>


@section Scripts {
    @{
        // await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <partial name="_ValidationScriptsPartial" />
    }
}



