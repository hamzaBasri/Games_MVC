@model Category
@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2>Creer Categorie</h2>
            <hr/>
        </div>
        <div asp-validation-summary="All">
        
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="Name" class="p-0"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="DisplayOrder" class="p-0"></label>
            <input asp-for="DisplayOrder" class="form-control" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6 col-md-3">
            <button type="submit" class="btn btn-primary form-control" >Creer</button>
        </div>
        <div class="col-6  col-md-3">
            <a asp-controller="Category" asp-action="Index" class="btn btn-secondary border form-control">
                Retour
            </a>
        </div>
    </div>
    
</form>
@section Scripts {
    @{
        // await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <partial name="_ValidationScriptsPartial" />
    }
}



